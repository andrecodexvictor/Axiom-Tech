# Axiom Tech V3 runtime template
# Copy to .env for local overrides. Leave optional secret values blank.
# Never commit real credentials.

# Browser boundary
AXIOM_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Internal corpus and default persistent retrieval
AXIOM_DOCUMENTS_DIR=./documentos
AXIOM_VECTOR_BACKEND=chroma
AXIOM_CHROMA_PATH=./.axiom_chroma
AXIOM_CHROMA_COLLECTION=axiom_knowledge
AXIOM_CHUNK_SIZE=900
AXIOM_CHUNK_OVERLAP=150

# Offline deterministic behavior is the default
AXIOM_NVIDIA_ENABLED=false

# Optional NVIDIA NIM: outbound inference occurs only when explicitly enabled
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
AXIOM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Legacy model-specific keys remain accepted during migration.
KIMI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=

# Optional LangSmith tracing for LangGraph and provider calls.
# Keep input/output hiding enabled unless the data-retention review allows payloads.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=axiom-tech-v3
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Optional technical web research: fail-closed unless all fields are configured.
AXIOM_WEB_ENABLED=false
SERPER_API_KEY=
AXIOM_WEB_ALLOWLIST=docs.python.org,docs.nvidia.com,docs.langchain.com,github.com
AXIOM_WEB_TIMEOUT_SECONDS=8
AXIOM_WEB_MAX_RESPONSE_BYTES=1000000

# Pinecone adapter boundary: selecting pinecone currently fails transparently
# until a deployment-specific production adapter is supplied.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_ENVIRONMENT=

# Frontend build-time setting. Empty uses same-origin /api through the Compose proxy.
VITE_API_BASE_URL=
