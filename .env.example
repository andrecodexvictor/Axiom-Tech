# Axiom Tech V3 runtime template
# Copy to .env for local overrides. Leave optional secret values blank.
# Never commit real credentials.

# Browser boundary
AXIOM_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Internal corpus and default persistent retrieval
AXIOM_DOCUMENTS_DIR=./documentos
AXIOM_VECTOR_BACKEND=chroma
AXIOM_CHROMA_PATH=./.axiom_chroma
AXIOM_CHROMA_COLLECTION=axiom_knowledge
AXIOM_CHUNK_SIZE=900
AXIOM_CHUNK_OVERLAP=150

# Explicit model route. AXIOM_LLM_ROUTES can replace PROVIDER/FALLBACK with an
# ordered list such as nvidia,openai,deterministic. Fallback advances only after
# transient failures; use "none" to make a remote provider mandatory.
AXIOM_LLM_PROVIDER=deterministic
AXIOM_LLM_FALLBACK=none
AXIOM_LLM_ROUTES=
# Example alternative: AXIOM_LLM_ROUTES=nvidia-minimax,deterministic. When this field
# is set, leave AXIOM_LLM_PROVIDER and AXIOM_LLM_FALLBACK empty.
# Keep remote synthesis inside the default OCI API Gateway budget; transient
# failures use the explicit deterministic fallback instead of retrying twice.
AXIOM_LLM_TIMEOUT_SECONDS=8
AXIOM_LLM_MAX_RETRIES=0
AXIOM_LLM_CIRCUIT_FAILURE_THRESHOLD=3
AXIOM_LLM_CIRCUIT_RECOVERY_SECONDS=30

# Legacy selector retained for existing OCI/runtime bundles. The explicit route
# variables above take precedence when set.
AXIOM_NVIDIA_ENABLED=false

# Optional NVIDIA NIM: outbound inference occurs only when explicitly enabled
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/muse-glimmer-30b
AXIOM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional NVIDIA model routes: nvidia-kimi, nvidia-minimax, nvidia-deepseek.
KIMI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_KIMI_MODEL=moonshotai/kimi-k2.6
NVIDIA_MINIMAX_MODEL=minimaxai/minimax-m3
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro

# Optional official OpenAI route. A custom HTTPS-compatible endpoint additionally
# requires AXIOM_OPENAI_ALLOW_CUSTOM_BASE_URL=true.
OPENAI_API_KEY=
OPENAI_MODEL=
AXIOM_OPENAI_BASE_URL=https://api.openai.com/v1
AXIOM_OPENAI_ALLOW_CUSTOM_BASE_URL=false

# Explicit local embedding mode for development. Production can select an
# OpenAI-compatible NVIDIA endpoint with a dedicated embedding credential;
# disabled remains an explicit fail-closed option.
AXIOM_EMBEDDING_PROVIDER=deterministic
AXIOM_EMBEDDING_MODEL=text-embedding-3-small
AXIOM_EMBEDDING_DIMENSIONS=384
AXIOM_EMBEDDING_BASE_URL=https://api.openai.com/v1
AXIOM_EMBEDDING_API_KEY=
AXIOM_EMBEDDING_INPUT_TYPE=auto
AXIOM_EMBEDDING_TIMEOUT_SECONDS=10
AXIOM_EMBEDDING_BATCH_SIZE=64

# NVIDIA Nemotron-3 Embed 1B example (replace the model/dimensions together):
# AXIOM_EMBEDDING_PROVIDER=openai
# AXIOM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# AXIOM_EMBEDDING_DIMENSIONS=2048
# AXIOM_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# AXIOM_EMBEDDING_API_KEY=<dedicated-nvidia-embedding-key>

# Vector candidate expansion, lexical post-reranking, threshold, and MMR tuning.
AXIOM_RETRIEVAL_CANDIDATE_MULTIPLIER=4
AXIOM_RETRIEVAL_MIN_SCORE=0.12
AXIOM_RETRIEVAL_LEXICAL_WEIGHT=0.25
AXIOM_RETRIEVAL_MMR_LAMBDA=0.75

# Optional LangSmith tracing for LangGraph and provider calls.
# Keep input/output hiding enabled unless the data-retention review allows payloads.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=axiom-tech-v3
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Legacy LangChain aliases accepted by existing VM environments. Prefer the
# LANGSMITH_* names above for new configuration.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=
LANGCHAIN_PROJECT=

# Optional technical web research: fail-closed unless all fields are configured.
AXIOM_WEB_ENABLED=false
SERPER_API_KEY=
AXIOM_WEB_ALLOWLIST=docs.python.org,docs.nvidia.com,docs.langchain.com,github.com
AXIOM_WEB_TIMEOUT_SECONDS=8
AXIOM_WEB_MAX_RESPONSE_BYTES=1000000

# Pinecone adapter boundary: selecting pinecone currently fails transparently
# until a deployment-specific production adapter is supplied.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_ENVIRONMENT=

# Frontend build-time setting. Empty uses same-origin /api through the Compose proxy.
VITE_API_BASE_URL=
